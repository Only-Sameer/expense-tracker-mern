NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/expense_tracker
JWT_SECRET=replace-with-at-least-32-random-bytes
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
REFRESH_TOKEN_SHORT_HOURS=12
ADMIN_EMAILS=admin@example.com

# Optional verified email sender (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Optional Cloudflare Turnstile server key (pair with the public client site key).
TURNSTILE_SECRET_KEY=

# Optional Google Identity Services client ID (same as VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Configure ONE Redis option for shared distributed rate limits and lockouts.
# Docker/local Redis:
REDIS_URL=
# Upstash-compatible Redis REST:
REDIS_REST_URL=
REDIS_REST_TOKEN=

# Keep this different from JWT_SECRET when enabling 2FA; changing it later
# makes existing encrypted authenticator secrets impossible to decrypt.
TOTP_ENCRYPTION_KEY=

# Optional error monitoring. Empty means no diagnostics leave the server.
SENTRY_DSN=
